# PostgreSQL container
POSTGRES_DB=webant_skills
POSTGRES_USER=app
POSTGRES_PASSWORD=change-this-database-password
DATABASE_URL=postgresql+psycopg://app:change-this-database-password@postgres:5432/webant_skills

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters

# Required bootstrap account. Never use these example values in production.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=replace-this-with-a-unique-password-of-at-least-12-characters

# Comma-separated browser frontend origins. Do not use "*" with credentials.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# MinIO container
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=change-this-minio-password
S3_ENDPOINT_URL=http://minio:9000
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=change-this-minio-password
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=webant-skills
S3_PRESIGNED_TTL=900
S3_ADDRESSING_STYLE=path

# Railway API service mappings (set these in Railway, not in the local .env):
# DATABASE_URL=${{Postgres.DATABASE_URL}}
# S3_ENDPOINT_URL=${{Bucket.ENDPOINT}}
# S3_PUBLIC_ENDPOINT_URL=${{Bucket.ENDPOINT}}
# AWS_ACCESS_KEY_ID=${{Bucket.ACCESS_KEY_ID}}
# AWS_SECRET_ACCESS_KEY=${{Bucket.SECRET_ACCESS_KEY}}
# AWS_DEFAULT_REGION=${{Bucket.REGION}}
# S3_BUCKET_NAME=${{Bucket.BUCKET}}
# S3_ADDRESSING_STYLE=virtual
