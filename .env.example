# PostgreSQL
# Local development:
DATABASE_URL=postgresql+psycopg://app:change-me@localhost:5432/webant_skills
# Railway reference: ${{Postgres.DATABASE_URL}}
# The application must normalize postgresql:// to postgresql+psycopg://.

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-this-with-a-random-secret-of-at-least-32-characters

# S3-compatible object storage
# Local MinIO endpoint. Railway reference: ${{Bucket.ENDPOINT}}
S3_ENDPOINT_URL=http://localhost:9000
# Railway reference: ${{Bucket.ACCESS_KEY_ID}}
AWS_ACCESS_KEY_ID=replace-me
# Railway reference: ${{Bucket.SECRET_ACCESS_KEY}}
AWS_SECRET_ACCESS_KEY=replace-me
# Railway reference: ${{Bucket.BUCKET}}
S3_BUCKET_NAME=webant-skills
# Railway reference: ${{Bucket.REGION}}
AWS_DEFAULT_REGION=auto
S3_PRESIGNED_TTL=900
